---
import PostCard from './PostCard.astro';
import type { Section } from '../config/site';
import { formatDateShort, isoDate, type SectionItem } from '../lib/posts';

interface Props {
  section: Section;
  items: SectionItem[];
  /** 1-based. Page 1 lives at /<section>/, the rest at /<section>/page/<n>. */
  page: number;
  totalPages: number;
}

const { section, items, page, totalPages } = Astro.props;

const pageHref = (n: number) => (n === 1 ? `/${section.id}` : `/${section.id}/page/${n}`);

const titleClass =
  section.register === 'workshop'
    ? 'font-sans font-semibold tracking-tight'
    : 'font-serif font-semibold';
---

<section class="article-measure mt-12">
  {
    items.length > 0 ? (
      <div class="flex flex-col gap-7">
        {items.map((item) =>
          item.kind === 'post' ? (
            <PostCard post={item.post} />
          ) : (
            <article class="group border-b border-rule pb-7 last:border-0">
              <a href={`/series/${item.series.slug}`} class="block no-underline">
                <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="label label-accent">In parts</span>
                  <time class="meta" datetime={isoDate(item.date)}>
                    {formatDateShort(item.date)}
                  </time>
                </div>

                <h2
                  class:list={[
                    'text-[1.4rem] leading-snug transition-colors group-hover:text-madder-ink',
                    titleClass,
                  ]}
                >
                  {item.series.name}
                </h2>

                <ol class="mt-3 flex flex-col gap-1">
                  {item.series.parts.slice(0, 3).map((part) => (
                    <li lang={part.lang} class="text-[0.97rem] text-ink-soft">
                      {part.series?.order}. {part.title}
                    </li>
                  ))}
                  {item.series.parts.length > 3 && (
                    <li class="meta">and {item.series.parts.length - 3} more</li>
                  )}
                </ol>

                <span class="meta mt-3 block">
                  {item.series.parts.length}{' '}
                  {item.series.parts.length === 1 ? 'part' : 'parts'}
                </span>
              </a>
            </article>
          ),
        )}
      </div>
    ) : (
      <p class="rounded-sm border border-dashed border-rule px-5 py-8 text-center text-ink-soft">
        {section.emptyState}
      </p>
    )
  }

  {
    totalPages > 1 && (
      <nav
        class="mt-12 flex items-center justify-between border-t border-rule pt-6"
        aria-label={`${section.label} pages`}
      >
        {page > 1 ? (
          <a href={pageHref(page - 1)} rel="prev" class="label text-madder-ink no-underline">
            ← Newer
          </a>
        ) : (
          <span class="label text-ink-faint">← Newer</span>
        )}

        <span class="meta tabular-nums">Page {page} of {totalPages}</span>

        {page < totalPages ? (
          <a href={pageHref(page + 1)} rel="next" class="label text-madder-ink no-underline">
            Older →
          </a>
        ) : (
          <span class="label text-ink-faint">Older →</span>
        )}
      </nav>
    )
  }
</section>
