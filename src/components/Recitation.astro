---
/**
 * A recitation player for a poem — the signature feature of the poetry section.
 *
 * Deliberately not a bare <audio controls>: the browser widget is visually
 * foreign to a page set like a book. This is a small custom transport over the
 * same native element, so seeking, keyboard access and screen readers still
 * work through real controls.
 *
 * preload="none" matters. A recitation is a few megabytes, and fetching it
 * before anyone presses play would cost every visitor the download.
 */
interface Props {
  src: string;
  label?: string;
}

const { src, label = 'Listen to the poet read this' } = Astro.props;

// Distinct ids so several players can coexist on one page — a series index, say.
const uid = `recitation-${Math.random().toString(36).slice(2, 9)}`;
---

<figure
  class="recitation mt-10 border-y border-rule py-4"
  data-recitation
  aria-labelledby={`${uid}-label`}
>
  <div class="flex items-center gap-4">
    <button
      type="button"
      data-play
      class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-madder text-paper transition-transform duration-200 hover:scale-105 active:scale-95"
      aria-label="Play recitation"
    >
      <svg
        data-icon-play
        class="ml-[2px] h-4 w-4"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 5.2v13.6L19 12z" />
      </svg>
      <svg
        data-icon-pause
        class="hidden h-4 w-4"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z" />
      </svg>
    </button>

    <div class="min-w-0 flex-1">
      <p id={`${uid}-label`} class="label label-accent mb-1.5">{label}</p>

      <div class="flex items-center gap-3">
        <input
          type="range"
          data-seek
          min="0"
          max="100"
          value="0"
          step="0.1"
          class="seek h-1 w-full cursor-pointer"
          aria-label="Seek within recitation"
        />
        <span class="meta shrink-0 tabular-nums" data-time>0:00</span>
      </div>
    </div>
  </div>

  <audio data-audio preload="none" src={src}></audio>

  <noscript>
    <audio controls preload="none" src={src} class="mt-3 w-full"></audio>
  </noscript>
</figure>

<style>
  /* A range input styled to match the palette, in both engines. */
  .seek {
    appearance: none;
    background: transparent;
  }

  .seek::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--rule-firm);
    border-radius: 2px;
  }

  .seek::-moz-range-track {
    height: 2px;
    background: var(--rule-firm);
    border-radius: 2px;
  }

  .seek::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--madder);
  }

  .seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--madder);
  }

  /* Without JavaScript the custom transport cannot work, so hide it and let the
     <noscript> native player take over. */
  html.no-js .recitation > div:first-child {
    display: none;
  }
</style>

<script>
  const formatTime = (seconds: number): string => {
    if (!Number.isFinite(seconds)) return '0:00';
    const total = Math.floor(seconds);
    const mins = Math.floor(total / 60);
    const secs = total % 60;
    return `${mins}:${String(secs).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-recitation]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]');
    const playButton = root.querySelector<HTMLButtonElement>('[data-play]');
    const seek = root.querySelector<HTMLInputElement>('[data-seek]');
    const time = root.querySelector<HTMLElement>('[data-time]');
    const iconPlay = root.querySelector<SVGElement>('[data-icon-play]');
    const iconPause = root.querySelector<SVGElement>('[data-icon-pause]');

    if (!audio || !playButton || !seek || !time || !iconPlay || !iconPause) return;

    let scrubbing = false;

    const showPaused = () => {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      playButton.setAttribute('aria-label', 'Play recitation');
    };

    const showPlaying = () => {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      playButton.setAttribute('aria-label', 'Pause recitation');
    };

    playButton.addEventListener('click', () => {
      if (audio.paused) {
        // Pause any other recitation already playing on this page.
        document.querySelectorAll<HTMLAudioElement>('[data-audio]').forEach((other) => {
          if (other !== audio) other.pause();
        });
        void audio.play().catch(() => {
          // Autoplay policy or a missing file — leave the control in its paused
          // state rather than lying about what is happening.
          showPaused();
        });
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', showPlaying);
    audio.addEventListener('pause', showPaused);
    audio.addEventListener('ended', () => {
      showPaused();
      seek.value = '0';
      time.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('loadedmetadata', () => {
      time.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (scrubbing || !Number.isFinite(audio.duration)) return;
      seek.value = String((audio.currentTime / audio.duration) * 100);
      time.textContent = formatTime(audio.duration - audio.currentTime);
    });

    seek.addEventListener('pointerdown', () => {
      scrubbing = true;
    });

    const commitSeek = () => {
      if (Number.isFinite(audio.duration)) {
        audio.currentTime = (Number(seek.value) / 100) * audio.duration;
      }
      scrubbing = false;
    };

    seek.addEventListener('pointerup', commitSeek);
    seek.addEventListener('change', commitSeek);
  });
</script>
