---
/**
 * A YouTube embed that costs nothing until someone presses play.
 *
 * A bare YouTube iframe pulls well over a megabyte of JavaScript and sets
 * cookies before a visitor has shown any interest in the video. This renders a
 * static panel and swaps in the iframe on click, using the nocookie domain.
 *
 * Video is never committed to the repository — GitHub caps single files at
 * 100 MB and every clone would carry every clip forever.
 */
interface Props {
  /** The YouTube video id, not the full URL. */
  id: string;
  title: string;
  /** Optional caption rendered under the player. */
  caption?: string;
}

const { id, title, caption } = Astro.props;

const embedUrl = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
---

<figure class="not-prose my-9">
  <div
    class="video-frame relative w-full overflow-hidden rounded-sm border border-rule bg-surface"
    data-video
    data-embed={embedUrl}
    data-title={title}
  >
    <button
      type="button"
      data-video-play
      class="group absolute inset-0 grid h-full w-full place-items-center gap-3 p-6 text-center"
      aria-label={`Play video: ${title}`}
    >
      <span
        class="grid h-14 w-14 place-items-center rounded-full bg-madder text-paper transition-transform duration-200 group-hover:scale-105"
      >
        <svg class="ml-[3px] h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.2v13.6L19 12z" />
        </svg>
      </span>
      <span class="font-sans text-sm font-semibold text-ink">{title}</span>
      <span class="label">Loads from YouTube on play</span>
    </button>
  </div>

  {
    caption && (
      <figcaption class="meta mt-2.5">{caption}</figcaption>
    )
  }
</figure>

<style>
  .video-frame {
    aspect-ratio: 16 / 9;
  }

  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('[data-video-play]');
    const embed = frame.dataset.embed;
    const title = frame.dataset.title ?? 'Video';
    if (!button || !embed) return;

    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.title = title;
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        frame.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>
