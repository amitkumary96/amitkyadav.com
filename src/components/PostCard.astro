---
import { formatDateShort, isoDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Show which section it came from — needed on cross-section listings. */
  showSection?: boolean;
}

const { post, showSection = false } = Astro.props;
---

<article class="group border-b border-rule pb-7 last:border-0">
  <a href={post.url} class="block no-underline">
    <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
      {
        showSection && (
          <span class="label label-accent">{post.section.label}</span>
        )
      }
      <time class="meta" datetime={isoDate(post.date)}>
        {formatDateShort(post.date)}
      </time>
      {
        post.series && (
          <span class="meta">
            {post.series.name} &middot; part {post.series.order}
          </span>
        )
      }
      {
        post.draft && (
          <span class="label" style="color: var(--madder)">Draft</span>
        )
      }
    </div>

    <h2
      lang={post.lang}
      class:list={[
        'text-[1.4rem] leading-snug transition-colors group-hover:text-madder-ink',
        post.section.register === 'workshop'
          ? 'font-sans font-semibold tracking-tight'
          : 'font-serif font-semibold',
      ]}
    >
      {post.title}
    </h2>

    {
      post.excerpt && (
        <p lang={post.lang} class="mt-2 max-w-[52ch] text-ink-soft">
          {post.excerpt}
        </p>
      )
    }

    <div class="mt-3 flex items-center gap-4">
      <span class="meta">
        {post.format === 'verse' ? 'Verse' : `${post.readingMinutes} min read`}
      </span>
      {
        post.audio && (
          <span class="meta inline-flex items-center gap-1.5">
            <svg
              class="h-3 w-3"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 5.2v13.6L19 12z" />
            </svg>
            Recited
          </span>
        )
      }
    </div>
  </a>
</article>
