---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateShort, getPostsByYear, isoDate } from '../lib/posts';

export const prerender = true;

/**
 * Everything, by year, in one place.
 *
 * The section pages are for browsing a subject; this is for finding a thing you
 * half-remember. Deliberately dense — no excerpts, no cards — because its job is
 * to fit as much as possible on one screen.
 */
const years = await getPostsByYear();
const total = years.reduce((sum, group) => sum + group.posts.length, 0);
---

<BaseLayout
  title="Archive"
  description="Everything published on amitkyadav.com, by year — engineering notes, poetry, stories and life."
>
  <div class="register-literary">
    <div class="article-measure">
      <header class="border-b border-rule pb-7">
        <h1
          class="font-serif text-[clamp(1.8rem,1.4rem+1.8vw,2.4rem)] font-semibold leading-tight"
        >
          Archive
        </h1>
        <p class="mt-3 text-ink-soft">Everything, oldest habits and newest alike.</p>
        <p class="meta mt-4">
          {total} {total === 1 ? 'piece' : 'pieces'} across {years.length}{' '}
          {years.length === 1 ? 'year' : 'years'}
        </p>
      </header>

      {
        years.length === 0 ? (
          <p class="mt-10 rounded-sm border border-dashed border-rule px-5 py-8 text-center text-ink-soft">
            Nothing published yet.
          </p>
        ) : (
          <div class="mt-10 flex flex-col gap-12">
            {years.map((group) => (
              <section aria-labelledby={`year-${group.year}`}>
                <h2
                  id={`year-${group.year}`}
                  class="border-b border-rule-firm pb-2 font-sans text-sm font-bold tabular-nums text-madder-ink"
                >
                  {group.year}
                </h2>

                <ul class="mt-1 flex flex-col">
                  {group.posts.map((post) => (
                    <li class="border-b border-rule last:border-0">
                      <a
                        href={post.url}
                        class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3 no-underline"
                      >
                        <time
                          class="meta w-[5.5rem] shrink-0"
                          datetime={isoDate(post.date)}
                        >
                          {formatDateShort(post.date)}
                        </time>

                        <span
                          lang={post.lang}
                          class="min-w-0 flex-1 text-ink transition-colors group-hover:text-madder-ink"
                        >
                          {post.title}
                        </span>

                        <span class="label shrink-0">{post.section.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
