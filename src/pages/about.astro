---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, SITE } from '../config/site';

export const prerender = true;

const SKILLS = [
  {
    heading: 'Technical',
    items: [
      'Software testing and QA',
      'Test automation',
      'Quality assurance processes',
      'Bug tracking and documentation',
      'Agile and Scrum',
    ],
  },
  {
    heading: 'Creative',
    items: [
      'Poetry',
      'Storytelling',
      'Creative expression',
      'Content creation',
      'Critical thinking',
    ],
  },
] as const;
---

<BaseLayout
  title="About"
  description="Amit Kumar Yadav — senior QA engineer, poet and storyteller. Testing and automation on one side, Hindi verse and stories on the other."
>
  <div class="register-literary">
    <article class="article-measure">
      <header class="border-b border-rule pb-7">
        <h1
          class="font-serif text-[clamp(1.9rem,1.4rem+2vw,2.6rem)] font-semibold leading-tight -tracking-[0.012em]"
        >
          About
        </h1>
        <p class="meta mt-3">Senior QA engineer · Poet · Storyteller</p>
      </header>

      <div class="article-prose prose mt-9 max-w-none">
        <p>
          Hello — I'm Amit Kumar Yadav, a senior QA engineer who believes in the
          power of quality, in code and in life. By day I make sure software
          works properly. The rest of the time I write, mostly poetry and
          stories, mostly in Hindi and Hinglish.
        </p>
        <p>
          This site holds both halves. The engineering writing is about testing,
          automation and, increasingly, AI — what broke, what held, and why. The
          rest is <span lang="hi">कविता</span>, <span lang="hi">कहानी</span> and
          whatever a given week has taught me.
        </p>
      </div>

      <section class="mt-14" aria-labelledby="work-heading">
        <h2 id="work-heading" class="label mb-5 border-t border-rule pt-8">
          Professional
        </h2>
        <div class="border-l-2 border-madder pl-5">
          <h3 class="font-sans text-[1.05rem] font-semibold text-ink">
            Senior QA Engineer
          </h3>
          <p class="meta mt-1">Current role</p>
          <p class="mt-3 text-ink-soft">
            Specialising in software testing, quality assurance and test
            automation. Most interested in building test frameworks that stay
            trustworthy as a product grows.
          </p>
        </div>
      </section>

      <section class="mt-14" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="label mb-6 border-t border-rule pt-8">
          What I work with
        </h2>
        <div class="grid gap-8 sm:grid-cols-2">
          {
            SKILLS.map((group) => (
              <div>
                <h3 class="font-sans text-sm font-semibold text-madder-ink">
                  {group.heading}
                </h3>
                <ul class="mt-3 flex flex-col gap-1.5">
                  {group.items.map((item) => (
                    <li class="text-[0.97rem] text-ink-soft">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-14" aria-labelledby="writing-heading">
        <h2 id="writing-heading" class="label mb-6 border-t border-rule pt-8">
          What I write
        </h2>
        <ul class="flex flex-col gap-5">
          {
            SECTIONS.map((section) => (
              <li>
                <a href={`/${section.id}`} class="group block no-underline">
                  <span class="flex items-baseline gap-2.5">
                    <span
                      class:list={[
                        'font-semibold text-ink transition-colors group-hover:text-madder-ink',
                        section.register === 'workshop' ? 'font-sans' : 'font-serif',
                      ]}
                    >
                      {section.label}
                    </span>
                    {section.native && (
                      <span lang="hi" class="font-deva text-[0.95rem] text-ink-faint">
                        {section.native}
                      </span>
                    )}
                  </span>
                  <span class="mt-1 block text-[0.97rem] text-ink-soft">
                    {section.blurb}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-14 border-t border-rule pt-8">
        <blockquote class="border-l-2 border-madder pl-5">
          <p class="font-serif text-[1.1rem] italic leading-relaxed text-ink">
            Quality is not an act, it is a habit. Whether I'm testing software or
            writing a poem, I believe in attention to detail, continuous
            improvement, and the beauty of work that has been done properly.
            Technology and creativity aren't opposites — they're two ways of
            paying attention.
          </p>
        </blockquote>
      </section>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="label mb-4">Get in touch</h2>
        <p class="text-ink-soft">
          Always happy to talk about quality engineering, poetry, or anything in
          between. <a href="/contact">Send a message</a>, or reach me directly at{' '}
          <a href={`mailto:${SITE.social.email}`}>{SITE.social.email}</a>. I
          usually reply within a couple of days.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
