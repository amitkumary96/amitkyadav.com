---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

export const prerender = true;

/**
 * The form posts to /contact.php, a real endpoint served by Hostinger's PHP.
 *
 * It used to compose a mailto: link and hand the visitor back their own half-
 * finished email, which a good share of people on phones abandon. The endpoint
 * validates, guards against header injection, and mails the message directly.
 *
 * No JavaScript is involved: native validation, a normal POST, and a redirect
 * back here with a status. The mailto: address stays visible as a fallback for
 * anyone who would rather use their own client — or if PHP is ever unavailable.
 */

/** Statuses the endpoint can redirect back with. */
const MESSAGES: Record<string, { tone: 'good' | 'bad'; text: string }> = {
  sent: {
    tone: 'good',
    text: 'Thank you — your message is on its way. I usually reply within a couple of days.',
  },
  incomplete: {
    tone: 'bad',
    text: 'Your name, email and a message are all needed. Nothing was sent.',
  },
  email: {
    tone: 'bad',
    text: 'That email address did not look valid, so nothing was sent. Please check it.',
  },
  long: {
    tone: 'bad',
    text: 'That message is longer than the form accepts. Email me directly instead.',
  },
  timing: {
    tone: 'bad',
    text: 'The form was submitted too quickly, or the page had been open a long time. Please try again.',
  },
  failed: {
    tone: 'bad',
    text: 'The server could not send the message. Please email me directly.',
  },
  method: { tone: 'bad', text: 'That request was not a form submission.' },
};

const status = Astro.url.searchParams.get('status') ?? '';
const notice = MESSAGES[status];

const fieldClass =
  'w-full rounded-sm border border-rule bg-paper px-3.5 py-2.5 font-sans text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-madder focus:ring-0';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Amit Kumar Yadav — about quality engineering, poetry, or anything in between."
>
  <div class="register-literary">
    <div class="article-measure">
      <header class="border-b border-rule pb-7">
        <h1
          class="font-serif text-[clamp(1.9rem,1.4rem+2vw,2.6rem)] font-semibold leading-tight -tracking-[0.012em]"
        >
          Get in touch
        </h1>
        <p class="mt-3 text-ink-soft">
          About engineering, about a poem, or about nothing in particular.
        </p>
      </header>

      {
        notice && (
          <p
            role="status"
            class:list={[
              'mt-8 rounded-sm border px-4 py-3 font-sans text-sm',
              notice.tone === 'good'
                ? 'border-rule-firm bg-surface text-ink'
                : 'border-madder bg-madder-wash text-madder-ink',
            ]}
          >
            {notice.text}
          </p>
        )
      }

      <form method="post" action="/contact.php" class="mt-8 flex flex-col gap-6">
        {/* Stamped by the inline script below, not at build time. A build-time
            value would be identical for every visitor, would make the output
            non-deterministic, and would expire the form 24 hours after a deploy.
            Left empty when JavaScript is off, and the endpoint then skips the
            timing check rather than rejecting a real person. */}
        <input type="hidden" name="started" value="" data-started />

        {/* Hidden from people, tempting to naive bots. Not display:none, which
            some bots detect — off-screen with aria-hidden instead. */}
        <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="name" class="label">Your name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class={fieldClass}
            placeholder="Amit"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="label">Your email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class={fieldClass}
            placeholder="you@example.com"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="subject" class="label">
            Subject
            <span class="normal-case tracking-normal text-ink-faint">(optional)</span>
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            class={fieldClass}
            placeholder="What's this about?"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="label">Message</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            required
            maxlength="5000"
            class={`${fieldClass} resize-y`}
            placeholder="Say as much or as little as you like."></textarea>
        </div>

        <div class="flex flex-col gap-3">
          <button
            type="submit"
            class="self-start rounded-sm bg-madder px-5 py-2.5 font-sans text-sm font-semibold text-paper transition-transform duration-200 hover:scale-[1.02] active:scale-[0.99]"
          >
            Send message
          </button>
          <p class="meta">
            Goes straight to my inbox. Prefer your own mail app? Write to{' '}
            <a href={`mailto:${SITE.social.email}`}>{SITE.social.email}</a>.
          </p>
        </div>
      </form>

      <script is:inline>
        // Records when this page was opened, so the endpoint can tell a person
        // filling in a form from a script posting instantly.
        (() => {
          const field = document.querySelector('[data-started]');
          if (field) field.value = String(Math.floor(Date.now() / 1000));
        })();
      </script>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="label mb-5">Elsewhere</h2>
        <ul class="flex flex-col gap-3">
          {
            [
              { href: SITE.social.linkedin, label: 'LinkedIn', note: 'Professional things' },
              { href: SITE.social.github, label: 'GitHub', note: 'Code, including this site' },
              { href: SITE.social.twitter, label: 'Twitter', note: 'Shorter thoughts' },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-baseline justify-between gap-4 no-underline"
                >
                  <span class="font-sans text-[0.97rem] text-ink transition-colors group-hover:text-madder-ink">
                    {link.label}
                  </span>
                  <span class="meta">{link.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
