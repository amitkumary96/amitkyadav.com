---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

export const prerender = true;

/**
 * The form still composes a mailto: link rather than posting anywhere, because
 * static hosting has no endpoint to post to. That works, but it asks the visitor
 * to finish the job in their own mail client, and a good share of people on
 * phones will abandon it. Replacing this with a real submit — a free form
 * service or a Cloudflare Function — is outstanding work.
 *
 * Until then the page is honest about what pressing the button does.
 */
---

<BaseLayout
  title="Contact"
  description="Get in touch with Amit Kumar Yadav — about quality engineering, poetry, or anything in between."
>
  <div class="register-literary">
    <div class="article-measure">
      <header class="border-b border-rule pb-7">
        <h1
          class="font-serif text-[clamp(1.9rem,1.4rem+2vw,2.6rem)] font-semibold leading-tight -tracking-[0.012em]"
        >
          Get in touch
        </h1>
        <p class="mt-3 text-ink-soft">
          About engineering, about a poem, or about nothing in particular.
        </p>
      </header>

      <form
        id="contact-form"
        class="mt-10 flex flex-col gap-6"
        method="post"
        enctype="text/plain"
        action={`mailto:${SITE.social.email}`}
      >
        <div class="flex flex-col gap-2">
          <label for="name" class="label">Your name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="w-full rounded-sm border border-rule bg-paper px-3.5 py-2.5 font-sans text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-madder focus:ring-0"
            placeholder="Amit"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="label">Your email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full rounded-sm border border-rule bg-paper px-3.5 py-2.5 font-sans text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-madder focus:ring-0"
            placeholder="you@example.com"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="subject" class="label">Subject <span class="normal-case tracking-normal text-ink-faint">(optional)</span></label>
          <input
            type="text"
            id="subject"
            name="subject"
            class="w-full rounded-sm border border-rule bg-paper px-3.5 py-2.5 font-sans text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-madder focus:ring-0"
            placeholder="What's this about?"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="label">Message</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            required
            class="w-full resize-y rounded-sm border border-rule bg-paper px-3.5 py-2.5 font-sans text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-madder focus:ring-0"
            placeholder="Say as much or as little as you like."></textarea>
        </div>

        <div class="flex flex-col gap-3">
          <button
            type="submit"
            class="self-start rounded-sm bg-madder px-5 py-2.5 font-sans text-sm font-semibold text-paper transition-transform duration-200 hover:scale-[1.02] active:scale-[0.99]"
          >
            Open in my mail app
          </button>
          <p class="meta">
            This opens your own email app with the message filled in — you press
            send there. Prefer to skip it? Write to{' '}
            <a href={`mailto:${SITE.social.email}`}>{SITE.social.email}</a>.
          </p>
        </div>

        <p
          id="form-error"
          class="hidden rounded-sm border border-madder bg-madder-wash px-4 py-3 font-sans text-sm text-madder-ink"
          role="alert"
        >
        </p>
      </form>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="label mb-5">Elsewhere</h2>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 no-underline"
            >
              <span class="font-sans text-[0.97rem] text-ink transition-colors group-hover:text-madder-ink"
                >LinkedIn</span
              >
              <span class="meta">Professional things</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 no-underline"
            >
              <span class="font-sans text-[0.97rem] text-ink transition-colors group-hover:text-madder-ink"
                >GitHub</span
              >
              <span class="meta">Code, including this site</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 no-underline"
            >
              <span class="font-sans text-[0.97rem] text-ink transition-colors group-hover:text-madder-ink"
                >Twitter</span
              >
              <span class="meta">Shorter thoughts</span>
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ recipient: SITE.social.email }}>
  (() => {
    const form = document.getElementById('contact-form');
    const error = document.getElementById('form-error');
    if (!form || !error) return;

    const show = (message) => {
      error.textContent = message;
      error.classList.remove('hidden');
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      error.classList.add('hidden');

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const subject =
        String(data.get('subject') ?? '').trim() || 'Message from amitkyadav.com';

      if (!name || !email || !message) {
        show('Please fill in your name, your email and a message.');
        return;
      }

      const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(
        subject,
      )}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>
