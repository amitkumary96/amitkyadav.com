---
import { SITE } from '../../config/site';

export const prerender = true;

/**
 * The writing desk: Sveltia CMS, a static single-page app that talks straight to
 * the GitHub API.
 *
 * Why this shape:
 *   - No server. Sign-in is a fine-grained personal access token pasted once, so
 *     there is no OAuth app and no proxy to host — which is the only reason a
 *     browser-based CMS can run on static hosting at all.
 *   - It ships to both origins, and each writes to its own branch: production to
 *     master, staging to staging. Content is written on production and goes live;
 *     staging exists to test code and design changes, and its editor lets the CMS
 *     itself be exercised after such a change without touching live writing.
 *
 * Because the two look identical, the banner below states which site and which
 * branch, unmissably. That label is the only thing standing between "I edited the
 * live site" and "I edited the test site".
 *
 * Deliberately not using BaseLayout — the CMS owns the whole viewport and none of
 * the site's own typography or chrome should apply to it.
 */

// Pinned to a patch range. On a 0.x line a minor bump can break, and an editor
// that silently changes under you is worse than one that lags.
const CMS_SCRIPT = 'https://unpkg.com/@sveltia/cms@~0.193.1/dist/sveltia-cms.js';

const origin = Astro.site?.origin ?? `https://${SITE.domain}`;
const isProduction = origin === `https://${SITE.domain}`;
const branch = isProduction ? 'master' : 'staging';
const environment = isProduction ? 'LIVE SITE' : 'TEST SITE';
---

<!doctype html>
<html lang="en" data-pagefind-ignore="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Write — {SITE.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #fbfaf8;
      }

      /* Shown only until the CMS bundle takes over the page. */
      #boot {
        display: grid;
        place-items: center;
        gap: 0.75rem;
        height: 100%;
        font-family: system-ui, sans-serif;
        color: #52525f;
        text-align: center;
        padding: 1.5rem;
      }

      #boot .boot-warn {
        max-width: 30rem;
        padding: 0.6rem 0.9rem;
        border: 1px solid #a32e33;
        border-radius: 2px;
        background: #f5e9e8;
        color: #7e2226;
      }

      #boot p {
        max-width: 32rem;
        margin: 0;
      }

      #boot code {
        font-size: 0.85em;
        background: #f2f0ec;
        border: 1px solid #e2ded8;
        border-radius: 2px;
        padding: 0.1em 0.35em;
      }

      /* Stays visible above the editor once it loads. The two environments are
         visually identical otherwise, and this is the only thing distinguishing
         "editing the live site" from "editing the test site". */
      #env {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 9999;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 0.35rem 0.75rem;
        padding: 0.3rem 0.75rem;
        font-family: system-ui, sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fbfaf8;
        pointer-events: none;
      }

      #env.is-live {
        background: #a32e33;
      }

      #env.is-test {
        background: #3d3d49;
      }

      #env .env-detail {
        letter-spacing: 0.04em;
        text-transform: none;
        opacity: 0.85;
      }

      body {
        padding-top: 1.6rem;
      }
    </style>
  </head>
  <body>
    <div id="env" class={isProduction ? 'is-live' : 'is-test'}>
      <strong>{environment}</strong>
      <span class="env-detail">
        {origin.replace('https://', '')} · saves commit to <code>{branch}</code>
      </span>
    </div>

    <div id="boot">
      <p><strong>Loading the editor…</strong></p>

      <p class="boot-warn">
        Use <strong>“Sign In with Token”</strong> — not “Login with GitHub”.
      </p>

      <p>
        The GitHub button routes through Netlify's OAuth service, which this site
        does not use, so it returns <em>Not Found</em>. Token sign-in needs no
        server at all, which is the whole reason the editor can run here.
      </p>

      <p>
        The token needs <strong>Contents: Read and write</strong> on
        <code>{SITE.repo}</code> and nothing else.
      </p>

      <p>
        {
          isProduction
            ? 'Saves here commit to master and go live on the public site in about two minutes.'
            : 'Saves here commit to staging and appear on the test site only. Nothing written here reaches the public site.'
        }
      </p>

      <noscript>
        <p>This editor needs JavaScript.</p>
      </noscript>
    </div>

    <script is:inline src={CMS_SCRIPT}></script>

    <script is:inline>
      /**
       * Custom blocks, offered under the editor's Insert menu.
       *
       * Only registered for .mdx sections — a component tag written into a .md
       * file would render as literal text. The poetry section is .md on purpose,
       * and gets its media from frontmatter instead.
       *
       * Each block round-trips through a regex: `pattern` finds it when reopening
       * a post, `fromBlock` reads the values out, `toBlock` writes them back.
       */
      (() => {
        const register = () => {
          const CMS = window.CMS;
          if (!CMS || typeof CMS.registerEditorComponent !== 'function') return false;

          /**
           * The preview pane renders in its own iframe, so none of the site's CSS
           * reaches it. Without this it uses the browser's default serif at
           * default sizes, which is most of why the editor felt like a form
           * rather than part of the site.
           */
          if (typeof CMS.registerPreviewStyle === 'function') {
            CMS.registerPreviewStyle('/admin/preview.css');
          }

          CMS.registerEditorComponent({
            id: 'video',
            label: 'Video (YouTube)',
            fields: [
              {
                name: 'id',
                label: 'YouTube video ID',
                widget: 'string',
                hint: 'Just the ID — the part after v= in the URL, not the whole link.',
              },
              { name: 'title', label: 'Title', widget: 'string' },
              { name: 'caption', label: 'Caption', widget: 'string', required: false },
            ],
            pattern: /^<Video\s+id="([^"]*)"\s+title="([^"]*)"(?:\s+caption="([^"]*)")?\s*\/>$/,
            fromBlock: (match) => ({
              id: match[1],
              title: match[2],
              caption: match[3] || '',
            }),
            toBlock: ({ id, title, caption }) =>
              caption
                ? `<Video id="${id || ''}" title="${title || ''}" caption="${caption}" />`
                : `<Video id="${id || ''}" title="${title || ''}" />`,
            toPreview: ({ title }) =>
              `<p style="border:1px solid #c9c4bc;padding:1rem;text-align:center">Video: ${
                title || 'untitled'
              }</p>`,
          });

          CMS.registerEditorComponent({
            id: 'callout',
            label: 'Callout',
            fields: [
              {
                name: 'type',
                label: 'Kind',
                widget: 'select',
                options: ['note', 'warning', 'aside'],
                default: 'note',
              },
              { name: 'title', label: 'Heading', widget: 'string', required: false },
              { name: 'text', label: 'Text', widget: 'text' },
            ],
            pattern: /^<Callout\s+type="([^"]*)"(?:\s+title="([^"]*)")?\s*>\n([\s\S]*?)\n<\/Callout>$/,
            fromBlock: (match) => ({
              type: match[1],
              title: match[2] || '',
              text: match[3],
            }),
            toBlock: ({ type, title, text }) => {
              const attrs = title
                ? `type="${type || 'note'}" title="${title}"`
                : `type="${type || 'note'}"`;
              return `<Callout ${attrs}>\n${text || ''}\n</Callout>`;
            },
            toPreview: ({ type, title, text }) =>
              `<aside style="border-left:3px solid #a32e33;padding:0.5rem 0.75rem"><strong>${
                title || type || 'Note'
              }</strong><br>${text || ''}</aside>`,
          });

          return true;
        };

        // The bundle is a classic script so window.CMS should already exist, but
        // fail loudly rather than silently skipping the blocks if it does not.
        if (register()) return;

        let attempts = 0;
        const timer = setInterval(() => {
          attempts += 1;
          if (register() || attempts > 40) {
            clearInterval(timer);
            if (attempts > 40) {
              console.error(
                '[admin] Sveltia CMS did not expose window.CMS — custom blocks are unavailable.',
              );
            }
          }
        }, 100);
      })();
    </script>
  </body>
</html>
