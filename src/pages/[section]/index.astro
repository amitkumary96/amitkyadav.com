---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SectionListing from '../../components/SectionListing.astro';
import { SECTIONS, type Section } from '../../config/site';
import {
  PAGE_SIZE,
  getSectionItems,
  getSectionPosts,
  type SectionItem,
} from '../../lib/posts';

export const prerender = true;

/**
 * Page one of a section. Pages two onward live at /<section>/page/<n>, which
 * keeps them from colliding with post slugs under /<section>/<slug>.
 *
 * One template for every section — this replaced three near-identical listing
 * files that each re-implemented the same glob and filename parsing.
 */
export async function getStaticPaths() {
  return Promise.all(
    SECTIONS.map(async (section) => {
      const items = await getSectionItems(section.id);
      const posts = await getSectionPosts(section.id);

      return {
        params: { section: section.id },
        props: {
          section,
          items: items.slice(0, PAGE_SIZE),
          total: posts.length,
          totalPages: Math.max(1, Math.ceil(items.length / PAGE_SIZE)),
        },
      };
    }),
  );
}

interface Props {
  section: Section;
  items: SectionItem[];
  total: number;
  totalPages: number;
}

const { section, items, total, totalPages } = Astro.props;
---

<BaseLayout title={section.label} description={section.blurb}>
  <div class:list={[`register-${section.register}`]}>
    <SectionHeader section={section} total={total} />
    <SectionListing section={section} items={items} page={1} totalPages={totalPages} />
  </div>
</BaseLayout>
