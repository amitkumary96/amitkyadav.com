---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS, type Section } from '../../config/site';
import { getAllSeries, getSectionPosts, type Post, type Series } from '../../lib/posts';

export const prerender = true;

/**
 * One template for every section. This replaced six near-identical page files —
 * three listings and three post pages — each of which re-implemented the same
 * glob and filename parsing.
 */
export async function getStaticPaths() {
  return Promise.all(
    SECTIONS.map(async (section) => ({
      params: { section: section.id },
      props: {
        section,
        posts: await getSectionPosts(section.id),
        series: (await getAllSeries()).filter((s) => s.section.id === section.id),
      },
    })),
  );
}

interface Props {
  section: Section;
  posts: Post[];
  series: Series[];
}

const { section, posts, series } = Astro.props;

// A post that belongs to a series is listed under that series rather than twice.
const seriesPostUrls = new Set(series.flatMap((s) => s.parts.map((p) => p.url)));
const standalone = posts.filter((post) => !seriesPostUrls.has(post.url));
---

<BaseLayout
  title={section.label}
  description={section.blurb}
>
  <div class:list={[`register-${section.register}`]}>
    <header class="article-measure border-b border-rule pb-7">
      <div class="flex items-baseline gap-3">
        <h1
          class:list={[
            'text-[clamp(1.9rem,1.4rem+2vw,2.6rem)] font-semibold leading-tight',
            section.register === 'workshop'
              ? 'font-sans tracking-tight'
              : 'font-serif -tracking-[0.012em]',
          ]}
        >
          {section.label}
        </h1>
        {
          section.native && (
            <span lang="hi" class="font-deva text-[1.25rem] text-ink-faint">
              {section.native}
            </span>
          )
        }
      </div>
      <p class="mt-3 max-w-[46ch] text-ink-soft">{section.blurb}</p>
      <p class="meta mt-4">
        {posts.length === 0
          ? 'Nothing published yet'
          : `${posts.length} ${posts.length === 1 ? 'piece' : 'pieces'}`}
      </p>
    </header>

    {
      series.length > 0 && (
        <section class="article-measure mt-10" aria-labelledby="series-heading">
          <h2 id="series-heading" class="label mb-5">In parts</h2>
          <ul class="flex flex-col gap-3">
            {series.map((s) => (
              <li>
                <a
                  href={`/series/${s.slug}`}
                  class="group flex items-baseline justify-between gap-4 rounded-sm border border-rule px-4 py-3.5 no-underline transition-colors hover:border-rule-firm"
                >
                  <span
                    class:list={[
                      'text-ink transition-colors group-hover:text-madder-ink',
                      section.register === 'workshop' ? 'font-sans font-semibold' : 'font-serif',
                    ]}
                  >
                    {s.name}
                  </span>
                  <span class="meta shrink-0">
                    {s.parts.length} {s.parts.length === 1 ? 'part' : 'parts'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="article-measure mt-12">
      {
        standalone.length > 0 ? (
          <div class="flex flex-col gap-7">
            {standalone.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          series.length === 0 && (
            <p class="rounded-sm border border-dashed border-rule px-5 py-8 text-center text-ink-soft">
              {section.emptyState}
            </p>
          )
        )
      }
    </section>
  </div>
</BaseLayout>
