---
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/noto-serif-devanagari/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';

import DarkModeToggle from '../components/DarkModeToggle.astro';
import { NAV, SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  ogType?: 'website' | 'article';
  /** Set on article pages so the whole document carries the right language. */
  lang?: string;
  /** Force exclusion from search regardless of which origin is building. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  ogType = 'website',
  lang = 'en',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;

/**
 * Astro.site comes from astro.config.mjs, which reads SITE_URL. This used to be
 * a hardcoded production origin, so staging pages advertised production
 * canonicals and their own previews could never be trusted.
 */
const origin = Astro.site?.origin ?? 'https://amitkyadav.com';
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = image ? new URL(image, origin).href : null;

/**
 * Anything that is not the production origin must stay out of search results.
 * The staging site is currently reachable inside the production document root,
 * so this is the difference between one indexable site and two competing ones.
 */
const isProductionOrigin = origin === `https://${SITE.domain}`;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Applies the stored theme before first paint. Anything later, including a
         deferred module, would show a flash of the wrong colours. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark =
            stored === 'dark' ||
            (stored === null &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
        } catch {
          // Storage unavailable — fall through to the light default.
        }
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    {
      (noindex || !isProductionOrigin) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — RSS`}
      href="/rss.xml"
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-madder focus:px-3 focus:py-2 focus:font-sans focus:text-sm focus:text-paper"
    >
      Skip to content
    </a>

    <header class="border-b border-rule">
      <div class="shell flex items-center justify-between gap-6 py-5">
        <a
          href="/"
          class="font-serif text-lg font-semibold tracking-tight text-ink no-underline"
        >
          {SITE.title}
        </a>

        <nav class="hidden md:block" aria-label="Primary">
          <ul class="flex items-center gap-6">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={[
                      'font-sans text-sm no-underline transition-colors',
                      isCurrent(item.href)
                        ? 'text-madder-ink'
                        : 'text-ink-soft hover:text-ink',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <DarkModeToggle />
          <button
            id="menu-button"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            class="grid h-9 w-9 place-items-center rounded-sm border border-rule text-ink-soft transition-colors hover:text-ink md:hidden"
          >
            <svg
              class="h-[1.05rem] w-[1.05rem]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>

      <nav
        id="mobile-nav"
        class="hidden border-t border-rule md:hidden"
        aria-label="Primary, mobile"
      >
        <ul class="shell flex flex-col py-2">
          {
            NAV.map((item) => (
              <li class="border-b border-rule last:border-0">
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'block py-3 font-sans text-sm no-underline',
                    isCurrent(item.href) ? 'text-madder-ink' : 'text-ink-soft',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="shell flex-1 py-12 md:py-16">
      <slot />
    </main>

    <footer class="mt-8 border-t border-rule py-10">
      <div class="shell flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="meta">
          © {new Date().getFullYear()} {SITE.author}
        </p>

        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <li>
            <a href="/rss.xml" class="meta no-underline hover:text-ink">RSS</a>
          </li>
          <li>
            <a
              href={SITE.social.github}
              rel="me noopener noreferrer"
              target="_blank"
              class="meta no-underline hover:text-ink">GitHub</a
            >
          </li>
          <li>
            <a
              href={SITE.social.linkedin}
              rel="me noopener noreferrer"
              target="_blank"
              class="meta no-underline hover:text-ink">LinkedIn</a
            >
          </li>
          <li>
            <a
              href={SITE.social.twitter}
              rel="me noopener noreferrer"
              target="_blank"
              class="meta no-underline hover:text-ink">Twitter</a
            >
          </li>
          <li>
            <a href={`mailto:${SITE.social.email}`} class="meta no-underline hover:text-ink"
              >Email</a
            >
          </li>
        </ul>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.getElementById('menu-button');
        const nav = document.getElementById('mobile-nav');
        if (!button || !nav) return;

        button.addEventListener('click', () => {
          const open = nav.classList.toggle('hidden') === false;
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
      })();
    </script>
  </body>
</html>
